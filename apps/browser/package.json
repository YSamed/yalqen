{
  "name": "yalqen",
  "productName": "Yalqen",
  "version": "0.4.20",
  "private": true,
  "license": "MIT",
  "description": "A fast, privacy-minded web browser",
  "homepage": "https://yalqen.com/",
  "author": "Yalqen",
  "repository": "https://github.com/YSamed/yalqen",
  "main": "dist/main/main.js",
  "desktopName": "yalqen.desktop",
  "scripts": {
    "postinstall": "node scripts/prepare-terminal.mjs",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer && npm run build:native",
    "build:native": "node scripts/build-native.mjs",
    "build:main": "npm exec rimraf -- dist/main dist/shared && npm exec tsc -- -p tsconfig.main.json",
    "build:preload": "node scripts/build-preload.mjs",
    "build:renderer": "vite build",
    "typecheck": "npm exec tsc -- -p tsconfig.main.json --noEmit && npm exec tsc -- -p tsconfig.preload.json && npm exec svelte-check -- --tsconfig ./tsconfig.renderer.json",
    "lint": "npm exec eslint -- .",
    "format": "npm exec prettier -- --write .",
    "format:check": "npm exec prettier -- --check .",
    "test:prepare": "npm exec install-electron && npm run build:main && npm run build:preload",
    "test": "npm run test:prepare && node --test \"test/**/*.test.mjs\"",
    "test:shared": "npm run test:prepare && node --test \"test/!(platform)/**/*.test.mjs\"",
    "test:macos": "npm run test:shared -- \"test/platform/macos/**/*.test.mjs\"",
    "test:windows": "npm run test:shared -- \"test/platform/windows/**/*.test.mjs\"",
    "test:linux": "npm run test:shared -- \"test/platform/linux/**/*.test.mjs\"",
    "test:runtime": "npm run build && node scripts/test-runtime.mjs",
    "check:static": "npm run lint && npm run format:check && npm run typecheck",
    "check": "npm run check:static && npm test",
    "bench": "npm run build && node scripts/bench.mjs",
    "bench:backend": "npm run build:main && node scripts/bench-backend.mjs",
    "bench:interface": "npm run build:renderer && node scripts/bench-interface.mjs",
    "start": "npm run build && node scripts/launch-branded.mjs",
    "dev": "npm run build:main && npm run build:preload && npm run build:native && node scripts/dev.mjs",
    "package:mac": "npm run build && npm exec electron-builder -- --mac",
    "package:win": "npm run build && npm exec electron-builder -- --win",
    "package:linux": "npm run build && npm exec electron-builder -- --linux"
  },
  "devDependencies": {
    "@electron/osx-sign": "^2.7.2",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^24.19.2",
    "@types/which": "^3.0.4",
    "bippy": "^0.7.3",
    "electron": "github:castlabs/electron-releases#v45.2.1+wvcus",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "rimraf": "^6.1.4",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.yalqen.browser",
    "npmRebuild": false,
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "productName": "Yalqen",
    "directories": {
      "output": "build/release"
    },
    "asarUnpack": [
      "dist/native/**/*",
      "node_modules/node-pty/prebuilds/**/*",
      "node_modules/node-pty/build/**/*"
    ],
    "files": [
      "dist/main/**/*",
      "dist/native/**/*",
      "dist/preload/**/*",
      "dist/page-scripts/**/*",
      "dist/renderer/**/*",
      "dist/shared/**/*",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**/*",
      "!**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon-512.png",
        "to": "brand/icon-512.png"
      },
      {
        "from": "build/tr.lproj/InfoPlist.strings",
        "to": "tr.lproj/InfoPlist.strings"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "YSamed",
        "repo": "yalqen"
      }
    ],
    "protocols": [
      {
        "name": "Web sayfası",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "mac": {
      "files": [
        "!node_modules/node-pty/prebuilds/win32-*/**/*"
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "sign": "./scripts/sign-mac.mjs",
      "extendInfo": {
        "NSCameraUsageDescription": "Websites can use your camera when you allow it.",
        "NSDesktopFolderUsageDescription": "Yalqen lists the screenshots you take in its downloads when you turn this on in Settings.",
        "NSDocumentsFolderUsageDescription": "Yalqen saves files you download here and lists screenshots saved here when you turn this on in Settings.",
        "NSDownloadsFolderUsageDescription": "Yalqen saves files you download here and lists screenshots saved here when you turn this on in Settings.",
        "NSMicrophoneUsageDescription": "Websites can use your microphone when you allow it.",
        "NSLocationUsageDescription": "Websites can see your location when you allow it.",
        "NSLocationWhenInUseUsageDescription": "Websites can see your location when you allow it."
      },
      "artifactName": "Yalqen-${version}-${arch}.${ext}"
    },
    "win": {
      "files": [
        "!node_modules/node-pty/prebuilds/darwin-*/**/*"
      ],
      "target": "nsis",
      "icon": "resources/icon-512.png",
      "signtoolOptions": {
        "sign": "./scripts/sign-win.mjs"
      },
      "publish": [
        {
          "provider": "github",
          "owner": "YSamed",
          "repo": "yalqen",
          "channel": "latest-win"
        }
      ],
      "artifactName": "Yalqen-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh"
    },
    "linux": {
      "files": [
        "!node_modules/node-pty/prebuilds/win32-*/**/*"
      ],
      "target": "AppImage",
      "category": "Productivity",
      "syncDesktopName": true,
      "icon": "resources/icon-512.png",
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https"
      ],
      "artifactName": "Yalqen-${version}-${arch}.${ext}"
    },
    "electronLanguages": [
      "tr",
      "en"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "appImage": {
      "executableArgs": []
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.6.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "@ghostery/adblocker-electron": "^2.20.3",
    "@mozilla/readability": "^0.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cygpath": "^1.0.0",
    "dompurify": "^3.4.18",
    "electron-updater": "^6.8.11",
    "marked": "^18.2.1",
    "node-pty": "^1.1.0",
    "open": "^11.0.4",
    "parse5": "^8.1.1",
    "tldts": "^7.5.5",
    "which": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "http-cache-semantics": "^4.3.0",
    "minimatch@>=7": "^11.0.1"
  }
}
