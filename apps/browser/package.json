{
  "name": "yalqen",
  "productName": "Yalqen",
  "version": "0.3.32",
  "private": true,
  "license": "MIT",
  "description": "A fast, privacy-minded web browser for macOS",
  "homepage": "https://yalqen.com/",
  "repository": "https://github.com/YSamed/yalqen",
  "main": "dist/main/main.js",
  "scripts": {
    "postinstall": "node scripts/prepare-terminal.mjs",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "node -e \"for (const dir of ['dist/main', 'dist/shared']) require('node:fs').rmSync(dir, { recursive: true, force: true })\" && tsc -p tsconfig.main.json",
    "build:preload": "node scripts/build-preload.mjs",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json && svelte-check --tsconfig ./tsconfig.renderer.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build:main && npm run build:preload && node --test 'test/**/*.test.mjs'",
    "test:runtime": "node scripts/test-runtime.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "bench": "npm run build && node scripts/bench.mjs",
    "bench:backend": "npm run build:main && node scripts/bench-backend.mjs",
    "bench:interface": "npm run build:renderer && node scripts/bench-interface.mjs",
    "start": "npm run build && node scripts/launch-branded.mjs",
    "package:mac": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@electron/osx-sign": "^1.3.3",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.0",
    "bippy": "^0.7.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "^1.1.1"
  },
  "build": {
    "appId": "com.yalqen.browser",
    "productName": "Yalqen",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/node-pty/prebuilds/**/*",
      "node_modules/node-pty/build/**/*"
    ],
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/page-scripts/**/*",
      "dist/renderer/**/*",
      "dist/shared/**/*",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**/*",
      "!**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon-512.png",
        "to": "brand/icon-512.png"
      },
      {
        "from": "build/tr.lproj/InfoPlist.strings",
        "to": "tr.lproj/InfoPlist.strings"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "YSamed",
        "repo": "yalqen"
      }
    ],
    "protocols": [
      {
        "name": "Web sayfası",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "sign": "./scripts/sign.mjs",
      "extendInfo": {
        "NSCameraUsageDescription": "Websites can use your camera when you allow it.",
        "NSMicrophoneUsageDescription": "Websites can use your microphone when you allow it.",
        "NSLocationUsageDescription": "Websites can see your location when you allow it.",
        "NSLocationWhenInUseUsageDescription": "Websites can see your location when you allow it."
      },
      "artifactName": "Yalqen-${version}-${arch}.${ext}"
    },
    "electronLanguages": [
      "tr",
      "en"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.7.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.288",
    "@ghostery/adblocker-electron": "^2.18.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.14",
    "node-pty": "^1.1.0",
    "parse5": "^8.0.1",
    "tldts": "^7.4.15"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "http-cache-semantics": "^4.3.0"
  }
}
