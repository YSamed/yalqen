{
  "name": "yalqen-electron-prototype",
  "productName": "yalqen",
  "version": "0.0.0",
  "private": true,
  "description": "Phase 0 Electron + TypeScript + Svelte prototype",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && svelte-check --tsconfig ./tsconfig.renderer.json",
    "test": "npm run build:main && node --test \"test/*.test.mjs\"",
    "prestart": "node scripts/brand-electron-mac.mjs",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22.20.4",
    "electron": "^44.4.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "^1.1.1"
  }
}
